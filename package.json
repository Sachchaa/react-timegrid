{
  "name": "@codesutra/react-timegrid",
  "version": "0.0.1-beta",
  "description": "A full-featured React calendar component with month, week, and day views (beta release)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && pnpm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "node scripts/verify-dist.mjs",
    "changeset": "changeset",
    "storybook:build": "storybook build",
    "prepublishOnly": "pnpm run build && pnpm run verify:dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.15.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.1.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.1.0",
    "vitest-axe": "^1.0.0-pre.3",
    "eslint-plugin-storybook": "10.4.0"
  },
  "keywords": [
    "react",
    "calendar",
    "month-view",
    "week-view",
    "day-view",
    "events",
    "schedule",
    "tailwindcss",
    "beta"
  ],
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachinkanishka/react-timegrid.git"
  },
  "bugs": {
    "url": "https://github.com/sachinkanishka/react-timegrid/issues"
  },
  "homepage": "https://github.com/sachinkanishka/react-timegrid#readme"
}
